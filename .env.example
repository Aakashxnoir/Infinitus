NEXT_PUBLIC_SITE_URL=https://infinitus-seven.vercel.app

# Google Form for Contact (website & club enhancement queries)
NEXT_PUBLIC_CONTACT_FORM_URL=https://forms.gle/wMbC1SEdAXYYbFvn9

# Club admin panel (/admin) — required to view contact messages & attach Google Forms
ADMIN_PASSWORD=change-me-to-a-strong-password

# Supabase — omit to store contacts/forms locally under /data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional legacy email delivery (contact form UI now uses Google Form)
# Public address is configured in lib/site.js → SITE.contactEmail
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=infinitus@ritchennai.edu.in
